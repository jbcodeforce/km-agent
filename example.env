# ------------------------------------------
# LLM (oMLX, Ollama, OpenAI, or Anthropic)
# ------------------------------------------
#
KMA_LLM_PROVIDER=mlx
KMA_LLM_MODEL_ID="Qwen3.6:27b-4bit"
KMA_LLM_API_KEY=not-needed
KMA_LLM_HOST="127.0.0.1"
KMA_LLM_PORT="7999"
KMA_LLM_BASE_URL="http://localhost:7999/v1"
KMA_EMBED_PROVIDER=local
# Embedding backends (pick one):
#   local      — in-process MLX on Apple Silicon (uv sync --extra local-mlx); not in Docker
#   fastembed  — in-process CPU (uv sync --extra fastembed); default in Docker image
#   mlx        — HTTP to OMLX OpenAI-compatible /embeddings API
#   ollama     — HTTP to Ollama on host
# Primary (local): nomical-modernbert-embed-base-4bit; falls back to embeddinggemma-300m if load fails.
KMA_EMBED_MODEL=nomical-modernbert-embed-base-4bit
KMA_EMBED_DIMENSIONS=768
# Docker-friendly example:
# KMA_EMBED_PROVIDER=fastembed
# KMA_EMBED_MODEL=BAAI/bge-small-en-v1.5
# KMA_EMBED_DIMENSIONS=384
# Remote OMLX embed (when KMA_EMBED_PROVIDER=mlx):
# KMA_EMBED_BASE_URL="http://localhost:7999/v1"

# Parallel API key for web search + content extraction.
# Enables the Researcher agent with parallel_search and parallel_extract.
# When configured, ingest_url auto-fetches bounded excerpts (not full pages).
# Get from: https://parallel.ai
KMA_PARALLEL_API_KEY=test_key
# Researcher Parallel limits (lower = less LLM context / MLX memory during tool loops)
KMA_PARALLEL_MAX_RESULTS=2
KMA_PARALLEL_MAX_CHARS_PER_RESULT=3000
KMA_PARALLEL_INGEST_MAX_CHARS=8000
# OMLX on 36GB Mac: unload embed model before long Researcher runs if chat+embed share OMLX;
# set memory_guard_tier=balanced on the OMLX server when prefill hits the memory ceiling.
# Scrapegrape ai for web scrapting.
SGAI_API_KEY=test_key
# ------------------------------------------
# Optional: Web Search (Exa — Navigator + Linter)
# ------------------------------------------

# Exa web search is available by default via free MCP server.
# Used by Navigator and Linter for general web search.
# Adding an API key enables authenticated access with higher limits.
# Get from: https://exa.ai
EXA_API_KEY=test_key

# ------------------------------------------
# Optional: Git Sync (GitHub-backed context)
# ------------------------------------------

# Both required together. Enables git-backed persistence for context/.
# GITHUB_ACCESS_TOKEN=
# REPO_URL=https://github.com/your-user/km-agent.git

# ------------------------------------------
# Context Directory
# ------------------------------------------

# Where Pal reads/writes user files, raw sources, and the wiki.
# Default: ./context (relative to project root)
KMA_CONTEXT_DIR=./context

# ------------------------------------------
# Database
# ------------------------------------------

# Docker Compose publishes Postgres on the host using POSTGRES_PUBLISH_PORT (default 5432).
# Host-side apps use KMA_DB_PORT (or legacy DB_PORT); keep KMA_DB_PORT equal to POSTGRES_PUBLISH_PORT when using Compose Postgres.
# POSTGRES_PUBLISH_PORT=5432
#
# Postgres data uses the named volume km-agent-postgres (see compose.yaml), not ./data/postgres,
# to avoid Docker Desktop chown/permission errors on bind mounts.

# Connection settings for kma.db / pytest on your machine (host -> published port).
# Prefer KMA_DB_*; legacy DB_* names are still read if the KMA_ variable is unset.
# Use localhost (not agent-db; that hostname only exists inside the Compose network).
KMA_DB_USER=ai
KMA_DB_PASS=ai
KMA_DB_HOST=localhost
KMA_DB_PORT=5432
KMA_DB_DATABASE=ai

# ------------------------------------------
# AgentOS / Vite (optional — see example.env)
# ------------------------------------------
KMA_AGENT_OS_HOST=127.0.0.1
KMA_AGENT_OS_PORT=8000
KMA_VITE_PORT=5174

# ------------------------------------------
# verify_agent_env.sh (optional)
# ------------------------------------------
KMA_VERIFY_AGENT_DB_CONTAINER=1
KMA_VERIFY_TRACE_ENV=0
KMA_AGENT_REASONING=1
KMA_STREAM_EVENTS=1
KMA_SHOW_TEAM_MEMBERS=1
AGNO_DEBUG=true
AGNO_DEBUG_LEVEL=1



