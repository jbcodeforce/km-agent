
# ------------------------------------------
# Optional: Web Research (Parallel — Researcher agent)
# ------------------------------------------

# Parallel API key for web search + content extraction.
# Enables the Researcher agent with parallel_search and parallel_extract.
# When configured, ingest_url auto-fetches full page content.
# Without this key, the Researcher is disabled and ingest creates stubs.
# Get from: https://parallel.ai
# PARALLEL_API_KEY=

# ------------------------------------------
# Optional: Web Search (Exa — Navigator + Linter)
# ------------------------------------------

# Exa web search is available by default via free MCP server.
# Used by Navigator and Linter for general web search.
# Adding an API key enables authenticated access with higher limits.
# Get from: https://exa.ai
# EXA_API_KEY=

# ------------------------------------------
# Optional: Git Sync (GitHub-backed context)
# ------------------------------------------

# Both required together. Enables git-backed persistence for context/.
# GITHUB_ACCESS_TOKEN=
# REPO_URL=https://github.com/your-user/km-agent.git

# ------------------------------------------
# Context Directory
# ------------------------------------------

# Where Pal reads/writes user files, raw sources, and the wiki.
# Default: ./context (relative to project root)
KMA_CONTEXT_DIR=./context

# ------------------------------------------
# Database
# ------------------------------------------

# Docker Compose publishes Postgres on the host using POSTGRES_PUBLISH_PORT (default 5432).
# This is independent of DB_PORT so an empty or app-only DB_PORT in .env cannot remove port mapping.
# POSTGRES_PUBLISH_PORT=5432
#
# Postgres data uses the named volume km-agent-postgres (see compose.yaml), not ./data/postgres,
# to avoid Docker Desktop chown/permission errors on bind mounts.

# Connection settings for kma.db / pytest on your machine (host -> published port).
# Use localhost (not agent-db; that hostname only exists inside the Compose network).
# DB_USER=ai
# DB_PASS=ai
# DB_HOST=localhost
# DB_PORT=5432
# DB_DATABASE=ai

# ------------------------------------------
# Compiler chat LLM (Ollama, OpenAI, or Anthropic)
# ------------------------------------------
#
# Default: ollama. For OpenAI or Anthropic, set the provider and API key; optional model id
# (otherwise defaults are chosen per provider — see kma/config.py).

KMA_LLM_PROVIDER=ollama
KMA_MODEL_ID=qwen3.6:35b-a3b
#
# KMA_LLM_PROVIDER=openai
# KMA_LLM_API_KEY=sk-...
# Optional: Azure or compatible base URL
# OPENAI_BASE_URL=https://api.openai.com/v1
#
# KMA_LLM_PROVIDER=anthropic
# LMA_LLM_API_KEY=sk-ant-...
#
# ------------------------------------------
# Knowledge / PgVector embeddings (Ollama or OpenAI)
# ------------------------------------------
#
# Default: ollama. For OpenAI embeddings, set provider and OPENAI_API_KEY (same key as chat if both OpenAI).
# KMA_EMBED_PROVIDER=ollama
# KMA_EMBED_MODEL=nomic-embed-text:latest
# KMA_EMBED_DIMENSIONS=768
#
# KMA_EMBED_PROVIDER=openai
# KMA_EMBED_MODEL=text-embedding-3-small
# KMA_EMBED_DIMENSIONS=1536
# Optional:
# OPENAI_BASE_URL=https://api.openai.com/v1
#
# Changing embedding provider, model, or dimensions requires re-ingesting or a fresh Postgres
# volume so existing vector tables match the new embedder output size.
#
# ------------------------------------------
# Ollama (native on the host — used when LLM or embed provider is ollama)
# ------------------------------------------
#
# Run ./scripts/setup.sh once (installs the ollama CLI if missing), then in a separate terminal:
#   ./scripts/starter.sh
# (starter.sh also runs `docker compose up -d agent-db` when Postgres is not already running.)
#
# Host-side apps and pytest integration tests default to http://127.0.0.1:11434.
# When the API runs inside Docker (km-agent service), compose defaults OLLAMA_HOST to
# host.docker.internal so the container reaches your host Ollama.
# OLLAMA_HOST=http://127.0.0.1:11434
# OLLAMA_PORT=11434
# KMA_IT_OLLAMA_MODEL=qwen2.5:3b
#
# Optional: override embed API host when KMA_EMBED_PROVIDER=ollama (otherwise OLLAMA_HOST is used, /v1 stripped).
# OLLAMA_EMBED_HOST=http://127.0.0.1:11434

# ------------------------------------------
# Integration tests (optional)
# ------------------------------------------
#
# Compiler agent integration test (see tests/it/test_compiler_agent_integration.py):
#   KMA_IT_COMPILER=1 uv run pytest tests/it -m integration -k compiler -v

# ------------------------------------------
# Server
# ------------------------------------------

# API port. Default: 8000.
# PORT=8000
