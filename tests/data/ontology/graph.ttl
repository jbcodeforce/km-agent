        <http://km-agent.local/id/concept/complex-event-processing>,
        <http://km-agent.local/id/concept/kafka-streams>,
        <http://km-agent.local/id/concept/rule-engines> ;
    kma:wikiPath "wiki/concepts/apache-flink.md" .

